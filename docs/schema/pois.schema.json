{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mateuzas/wander/docs/schema/pois.schema.json",
  "title": "Wander POI file (pois-<city>.json)",
  "description": "Written by Data/score.py, bundled in the app, decoded by RouteEngine.POIFile. See docs/CONTRACTS.md §1.",
  "type": "object",
  "required": [
    "city",
    "generated",
    "pois"
  ],
  "additionalProperties": false,
  "properties": {
    "city": {
      "type": "string",
      "minLength": 1,
      "description": "Display name, e.g. \"Vilnius\""
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "attribution": {
      "type": "string",
      "description": "Shown in the app: \"© OpenStreetMap contributors\""
    },
    "pois": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/poi"
      }
    }
  },
  "$defs": {
    "poi": {
      "type": "object",
      "required": [
        "id",
        "name",
        "lat",
        "lon",
        "category",
        "score",
        "kind",
        "reason",
        "hook",
        "photo"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(osm:(node|way|relation):[0-9]+|ovt:[0-9a-zA-Z_-]+)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name; English for sights"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "category": {
          "enum": [
            "photo",
            "shop",
            "food"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "kind": {
          "enum": [
            "passby",
            "stop"
          ],
          "description": "photo → passby; shop, food → stop"
        },
        "reason": {
          "type": "string",
          "description": "Short human reason; may be empty"
        },
        "type": {
          "type": "string",
          "description": "Most specific OSM value: mural, museum, church, cafe, books…"
        },
        "signals": {
          "type": "object",
          "required": [
            "photos",
            "fame",
            "quality",
            "independent"
          ],
          "additionalProperties": false,
          "properties": {
            "photos": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fame": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "quality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "independent": {
              "type": "boolean"
            }
          }
        },
        "cuisine": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "food only"
        },
        "openingHours": {
          "type": "string",
          "description": "Raw OSM opening_hours; shop and food only"
        },
        "localName": {
          "type": "string",
          "description": "Original OSM name when name is a translation"
        },
        "commonsImage": {
          "type": "string",
          "description": "Commons file name without File:; photo only"
        },
        "commonsCategory": {
          "type": "string",
          "description": "Commons category without Category:; photo only"
        },
        "popular": {
          "const": true,
          "description": "Present only when true; equals tier 1 (ADR 012)"
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300,
          "description": "1–2 factual sentences. Required for popular places when a source exists. Never invented: Wikipedia lead or OSM facts only"
        },
        "descriptionSource": {
          "enum": [
            "wikipedia",
            "osm"
          ],
          "description": "Where description came from; wikipedia needs credit and a link (CC BY-SA)"
        },
        "descriptionUrl": {
          "type": "string",
          "pattern": "^https://",
          "description": "Source page for credit; required when descriptionSource is wikipedia"
        },
        "tier": {
          "enum": [
            1,
            2,
            3
          ],
          "description": "Map importance within the category (ADR 012): 1 must-see, 2 notable, 3 detail"
        },
        "sources": {
          "type": "array",
          "items": {
            "enum": [
              "osm",
              "overture"
            ]
          },
          "description": "Where the place was found (ADR 014); absent means osm only"
        },
        "website": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Official website, if known"
        },
        "instagram": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._]{1,30}$",
          "description": "Instagram handle without @, if known"
        },
        "new": {
          "const": true,
          "description": "First seen in the last 60 days (ADR 014); present only when true"
        },
        "hook": {
          "type": "string",
          "minLength": 10,
          "maxLength": 80,
          "description": "One eye-catching factual sentence (ADR 015); required for every published place"
        },
        "photo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "source",
            "credit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "source": {
              "enum": [
                "commons",
                "mapillary",
                "website"
              ]
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string"
            },
            "page": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "description": "Photo shown in the card (ADR 015); required for every published place"
        }
      }
    }
  }
}
